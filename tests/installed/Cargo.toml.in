[workspace]
members = ["helper", "host", "kernels"]
resolver = "3"

[workspace.package]
edition = "2024"
license = "MIT"
publish = false
version = "0.0.0"

[workspace.dependencies]
external-helper = { path = "helper" }
metal-oxide = { path = "@CRATES@/metal-oxide" }
metal-oxide-device = { path = "@CRATES@/metal-oxide-device" }

[workspace.lints.rust]
unsafe_op_in_unsafe_fn = "deny"

[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
